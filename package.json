{
  "name": "hedgesync",
  "version": "2.6.0",
  "description": "A library and CLI to programmatically connect to a running HedgeDoc server and make live edits to documents",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./obsidian": {
      "import": {
        "types": "./dist/obsidian.d.ts",
        "default": "./dist/obsidian.js"
      }
    }
  },
  "bin": {
    "hedgesync": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "src",
    "deno.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test test/unit test/e2e && bun run test/test-all-features.ts",
    "test:unit": "bun test test/unit",
    "cli": "bun run bin/hedgesync.ts",
    "gen:nvim": "bun run scripts/gen-nvim-plugin.ts",
    "build:cli": "bun run gen:nvim && bun build bin/hedgesync.ts --compile --outfile dist/hedgesync",
    "build:all": "bun run scripts/build-binaries.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/bin.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.build.json",
    "test:e2e": "bun test test/e2e"
  },
  "keywords": [
    "hedgedoc",
    "realtime",
    "collaboration",
    "operational-transformation",
    "socket.io",
    "cli",
    "markdown",
    "editor"
  ],
  "author": "tionis.dev",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tionis/hedgesync.git"
  },
  "bugs": {
    "url": "https://github.com/tionis/hedgesync/issues"
  },
  "homepage": "https://github.com/tionis/hedgesync#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "socket.io-client": "^4.7.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "socket.io": "4.8.1",
    "typescript": "^5.0.0"
  }
}
